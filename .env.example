# Optional: leave blank to use the built-in musical rules.
# Copy this file to .env and set your private OpenAI API key there.
# Restart the backend after editing .env. Never use a VITE_ variable for this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Hosted melody-conditioned previews (optional, paid per generation).
# Store the private token ONLY in .env, never in VITE_ variables or source code.
# auto selects Replicate when a token is present; local keeps free CPU inference.
REPLICATE_API_TOKEN=
MUSE_MELODY_PROVIDER=auto

# Optional local MusicGen Melody inference service. Leave blank for the strict
# note-conditioned arranger. See docs/MUSICGEN_LOCAL.md for free CPU setup with
# the official Transformers implementation, or use compatible AudioCraft on GPU.
# It produces a separate unverified neural preview, never a silent replacement.
MUSE_MELODY_MODEL_URL=
# Finite CPU generation deadline in milliseconds (default 30 minutes, max 1 hour).
MUSE_MELODY_TIMEOUT_MS=1800000
